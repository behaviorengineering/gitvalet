#!/usr/bin/env bash
# Format staged Go files before commit (matches CI gofumpt gate).
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"

files=()
while IFS= read -r f; do
	[[ -n "$f" ]] && files+=("$f")
done <<EOF
$(git diff --cached --name-only --diff-filter=ACM -- '*.go' || true)
EOF

if ((${#files[@]} == 0)); then
	exit 0
fi

GOWORK=off go tool gofumpt -w "${files[@]}"
for f in "${files[@]}"; do
	git add "$f"
done

unformatted="$(GOWORK=off go tool gofumpt -l "${files[@]}")"
if [[ -n "$unformatted" ]]; then
	echo "gofumpt: still unformatted after write:" >&2
	echo "$unformatted" >&2
	exit 1
fi
